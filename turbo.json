{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test:unit": {
      "outputs": []
    },
    "test:integration": {
      "outputs": [],
      "env": ["DATABASE_URL", "REDIS_URL", "NATS_URL", "CLICKHOUSE_URL", "JWT_PRIVATE_KEY_PATH", "JWT_PUBLIC_KEY_PATH", "INTERNAL_API_SECRET", "MINIO_URL", "MINIO_ROOT_USER", "MINIO_ROOT_PASSWORD", "MINIO_WEBHOOK_AUTH_TOKEN", "EDGE_HOSTNAME", "SCHEDULER_SERVICE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
